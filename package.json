{
  "name": "market-research-agent",
  "version": "1.0.0",
  "description": "A reusable CLI that searches the web and creates structured market research reports.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhruvingajjar15/market-research-agent.git"
  },
  "homepage": "https://github.com/dhruvingajjar15/market-research-agent#readme",
  "bugs": {
    "url": "https://github.com/dhruvingajjar15/market-research-agent/issues"
  },
  "type": "module",
  "bin": {
    "market-research-agent": "dist/index.js",
    "market-research": "dist/index.js"
  },
  "files": [
    "dist",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "research": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "market-research",
    "cli",
    "openai",
    "tavily"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "openai": "^7.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
